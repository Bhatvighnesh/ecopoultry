# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/ecopoultry

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ML microservice (Flask)
ML_SERVICE_URL=http://localhost:5001

# Stale sensor threshold (ms) - dashboard flags "data may be outdated" if no reading within this window
STALE_DATA_MS=20000

# Seed admin (used only by npm run seed:admin)
SEED_ADMIN_EMAIL=admin@ecopoultry.local
SEED_ADMIN_PASSWORD=ChangeMe123!
